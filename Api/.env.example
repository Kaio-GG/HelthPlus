# Copie este arquivo para Api/.env e preencha com os dados da sua máquina.
# O arquivo .env NÃO vai para o Git (cada pessoa tem o seu).

# ---- Banco de dados (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Precisa ser igual ao nome criado em Api/database/schema.sql
# Atenção: é "helthplus", sem o "a" — foi assim que o banco foi batizado.
DB_NAME=helthplus

# ---- Servidor ----
# A API sobe em 0.0.0.0, então o celular na mesma rede Wi-Fi alcança ela.
PORT=3000

# ---- Envio de e-mail ----
# Estas mesmas variáveis servem a TODOS os e-mails da API:
#   - convite de acesso do paciente (cadastro do paciente)
#   - redefinição de senha (nutricionista e paciente)
#   - aviso de que a senha foi alterada
#   - boas-vindas do nutricionista
#   - avisos do sino, para quem ligou "Resumo por e-mail"
#   - convite para testar o aplicativo (Perfil > Convidar alguém para testar)
#
# Enquanto estiverem vazias, a API NÃO envia e-mail: ela imprime a
# mensagem no terminal, com o código de redefinição. Os fluxos inteiros
# funcionam assim, sem conta de envio — o aplicativo avisa na tela quando
# a mensagem só foi para o terminal.
#
# Para enviar de verdade, preencha com os dados do seu provedor. Exemplos:
#   Gmail  -> host smtp.gmail.com, porta 587, e uma "senha de app" de 16
#             letras: a senha normal da conta NÃO funciona. A senha de app
#             só aparece depois de ligar a Verificação em duas etapas, em
#             myaccount.google.com/security, e é criada em
#             myaccount.google.com/apppasswords
#   Brevo  -> host smtp-relay.brevo.com, porta 587
#   Mailtrap (caixa de teste, não entrega de verdade)
#             -> host sandbox.smtp.mailtrap.io, porta 2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente que aparece no e-mail. Em branco, usa o SMTP_USER.
SMTP_REMETENTE=Health Plus <nao-responda@healthplus.app>

# ---- Convite para testar o aplicativo ----
# Endereço de instalação que vai no convite enviado pelo Perfil. Enquanto
# o aplicativo não estiver na Play Store, é o link do Expo ou do APK —
# ele muda a cada rodada de teste, por isso fica aqui e não no código.
# Vazio, a rota /api/convite/testador recusa o envio e explica o motivo.
LINK_TESTE_APP=

# ---- Autenticacao (JWT) ----
# Segredo que assina o token do login. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sem esta variavel o login devolve "Erro interno ao realizar login".
JWT_SECRET=
